  "endpoints": {
    "primary": {
      "level": "L1_local_transfer",
      "metric": "uncorrected_sibling_teacher_prefix_accuracy",
      "contrast": "correction_minus_replay",
      "seed_aggregation": "mean_within_family_over_fixed_seeds",
      "family_outcome": "win_if_positive_loss_if_negative_tie_if_zero"
    },
    "secondary": [
      {
        "level": "L1_local_transfer",
        "metric": "uncorrected_sibling_raw_nll",
        "contrast": "replay_minus_correction",
        "role": "continuous_diagnostic_positive_is_better_for_correction"
      },
      {
        "level": "L2_sequential_transfer",
        "metric": "strict_terminal_task_success",
        "contrast": "correction_minus_replay",
        "seed_aggregation": "mean_within_family_over_fixed_seeds"
      },
      {
        "level": "L2_sequential_transfer",
        "metric": "goal_verified",
        "contrast": "correction_minus_replay",
        "seed_aggregation": "mean_within_family_over_fixed_seeds"
      }
    ],
    "manipulation_check": {
      "level": "L0_repair",
      "metric": "corrected_state_accuracy",
      "note": "reported separately and never counted as transfer success"
    }
  },
  "analysis": {
    "primary_test": "exact_two_sided_sign_test_on_non_tied_family_outcomes",
    "alpha": 0.05,
    "planned_family_count": 30,
    "minimum_non_tied_families_for_confirmatory_verdict": 20,
    "supported_rule": "p<0.05 AND wins>losses AND median_family_accuracy_delta>0",
    "not_supported_rule": "p<0.05 AND losses>wins",
    "inconclusive_rule": "all other valid outcomes, including fewer than 20 non-tied families",
    "ties": "excluded_from_sign_test_but_reported",
    "multiple_comparisons": "only the primary endpoint receives a confirmatory hypothesis test; secondary endpoints are descriptive",
    "power_planning": {
      "method": "exact BinomialDistribution sign-test planning; independent families and no ties assumed",
      "power_at_n30_if_true_win_probability_0_75": 0.8034069187820484,
      "power_at_n30_if_true_win_probability_0_80": 0.9389128561889027,
      "note": "planning guidance only; not inference from development evidence"
    }
  },
